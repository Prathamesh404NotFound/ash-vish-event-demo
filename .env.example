# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The public-facing URL of the application.
# CRITICAL for PhonePe payments — PhonePe redirects back to this URL after
# checkout. If this is wrong or missing, users will be redirected to an
# incorrect URL and the booking will NOT be created even though payment succeeds.
# Set to the exact production domain with no trailing slash.
APP_URL=https://ashvishevents.com
VITE_APP_URL=https://ashvishevents.com

# ============================================================
# PHONEPE PAYMENT GATEWAY
# ============================================================
# All three variables below are required for online ticket payment to work.
# Without PHONEPE_CLIENT_ID + PHONEPE_CLIENT_SECRET the PhonePe OAuth token
# cannot be obtained, and the /api/phonepe/create-order endpoint will fail.
#
# Obtain credentials from: https://dashboard.phonepe.com → API Keys
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
# Set to "production" for live payments, "sandbox" for testing.
PHONEPE_ENV=production
#
# Register your webhook URL in the PhonePe Merchant Dashboard:
#   https://merchant.phonepe.com → Integrations → Webhooks
# Webhook URL to register: https://ashvishevents.com/api/phonepe/webhook
# The webhook is the fallback path that creates the booking when the user
# closes the browser before the return redirect completes.

# Razorpay (TEST MODE by default — use rzp_test_* keys).
# To go live: replace with rzp_live_* keys and register the webhook URL in the
# Razorpay dashboard. The server verifies the X-Razorpay-Signature header with
# RAZORPAY_KEY_SECRET for all fulfillment paths.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# FIREBASE CONFIGURATION (Client-side Public Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# FIREBASE ADMIN / SERVER-SIDE CONFIG
# These are required for the API server to authenticate with Firebase RTDB.
# Without these, ALL /api/* routes will return 500 ("Permission denied").
#
# Option A: Individual fields from your Firebase service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the service account JSON.
# In Vercel: add the full value including -----BEGIN/END----- lines.
# In .env files: replace literal newlines with \n  (e.g. -----BEGIN...\\n...-----END-----)
FIREBASE_PRIVATE_KEY=
#
# Option B: Full service account JSON as a single env var (alternative to A)
# FIREBASE_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}
#
# RTDB URL (optional — server falls back to the hardcoded project default)
FIREBASE_DATABASE_URL=

# SERVER SECURITY
# Generate with: openssl rand -hex 32
SERVER_HMAC_SECRET=
# During secret rotation only: keep the former value here until all old
# tickets, pass links, and counter PINs have expired or been reissued.
SERVER_HMAC_SECRET_PREVIOUS=

# ENOTIFY.APP WHATSAPP CONFIGURATION (Sole WhatsApp Sender)
ENOTIFY_API_URL=https://enotify.app/api
ENOTIFY_TOKEN=
ENOTIFY_ENABLED=true

