{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'admin-server-bot')",
        ".write": "auth != null && auth.uid === 'admin-server-bot'"
      }
    },
    "staff": {
      ".read": "auth != null && auth.uid === 'admin-server-bot'",
      "$uid": {
        ".read": "auth != null && auth.uid === 'admin-server-bot'",
        ".write": "auth != null && auth.uid === 'admin-server-bot'",
        ".validate": "newData.hasChildren(['email', 'role']) && (newData.child('role').val() === 'admin' || newData.child('role').val() === 'ticket_counter')"
      }
    },
    "events": { ".read": true, ".write": "auth != null && auth.uid === 'admin-server-bot'" },
    "coupons": {
      ".read": "auth != null && auth.uid === 'admin-server-bot'",
      ".write": "auth != null && auth.uid === 'admin-server-bot'"
    },
    "bookings": {
      ".read": "auth != null && auth.uid === 'admin-server-bot'",
      ".write": "auth != null && auth.uid === 'admin-server-bot'",
      "$bookingId": {
        ".read": "auth != null && auth.uid === 'admin-server-bot'",
        ".write": "auth != null && auth.uid === 'admin-server-bot'"
      }
    },
    "tickets": {
      ".read": "auth != null && auth.uid === 'admin-server-bot'",
      ".write": "auth != null && auth.uid === 'admin-server-bot'",
      "$ticketId": {
        ".read": "auth != null && auth.uid === 'admin-server-bot'",
        ".write": "auth != null && auth.uid === 'admin-server-bot'"
      }
    },
    "seats": { ".read": true, ".write": "auth != null && auth.uid === 'admin-server-bot'" },
    "reservations": { ".read": "auth != null && auth.uid === 'admin-server-bot'", ".write": "auth != null && auth.uid === 'admin-server-bot'" },
    "reservation_owners": { ".read": "auth != null && auth.uid === 'admin-server-bot'", ".write": "auth != null && auth.uid === 'admin-server-bot'" },
    "reservation_events": { ".read": "auth != null && auth.uid === 'admin-server-bot'", ".write": "auth != null && auth.uid === 'admin-server-bot'" },
    "pending_orders": { ".read": "auth != null && auth.uid === 'admin-server-bot'", ".write": "auth != null && auth.uid === 'admin-server-bot'" },
    "processed_orders": { ".read": "auth != null && auth.uid === 'admin-server-bot'", ".write": "auth != null && auth.uid === 'admin-server-bot'" },
    "organizers": {
      ".read": "auth != null && auth.uid === 'admin-server-bot'",
      ".write": "auth != null && auth.uid === 'admin-server-bot'",
      "$organizerId": {
        ".read": "auth != null && auth.uid === 'admin-server-bot'",
        ".write": "auth != null && auth.uid === 'admin-server-bot'"
      }
    },
    "reviews": { ".read": "auth != null && auth.uid === 'admin-server-bot'", ".write": "auth != null && auth.uid === 'admin-server-bot'" },
    "favorites": { ".read": false, ".write": false },
    "staff_uploads": {
      ".read": "auth != null && auth.uid === 'admin-server-bot'",
      ".write": "auth != null && auth.uid === 'admin-server-bot'"
    }
  }
}
