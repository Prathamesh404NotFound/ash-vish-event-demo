{
  "rules": {
    ".read": true,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('staff').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('staff').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "staff": {
      ".read": "auth != null && root.child('staff').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('staff').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('staff').child(auth.uid).child('role').val() === 'admin' || auth.uid === $uid)"
      }
    },
    "events": {
      ".read": true,
      ".write": false,
      "$eventId": {
        ".write": false
      }
    },
    "coupons": {
      ".read": true,
      ".write": false,
      "$code": {
        ".write": false
      }
    },
    "bookings": {
      ".read": "auth != null && root.child('staff').child(auth.uid).exists()",
      ".write": false,
      "$bookingId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('staff').child(auth.uid).exists())",
        ".write": false
      }
    },
    "tickets": {
      ".read": "auth != null && root.child('staff').child(auth.uid).exists()",
      ".write": false,
      "$ticketId": {
        ".read": "auth != null && (root.child('staff').child(auth.uid).exists() || data.child('ownerId').val() === auth.uid)",
        ".write": false
      }
    },
    "seats": {
      ".read": true,
      ".write": false,
      "$eventId": {
        ".read": true,
        ".write": false,
        "$seatId": {
          ".read": true,
          ".write": false
        }
      }
    },
    "reservations": {
      ".read": "auth != null",
      ".write": false,
      "$reservationId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "reservation_owners": {
      ".read": false,
      ".write": false
    },
    "reservation_events": {
      ".read": false,
      ".write": false
    },
    "pending_orders": {
      ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('staff').child(auth.uid).exists())",
      ".write": false,
      "$orderId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('staff').child(auth.uid).exists())",
        ".write": false
      }
    },
    "processed_orders": {
      ".read": "auth != null",
      ".write": false,
      "$orderId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "organizers": {
      ".read": true,
      ".write": false,
      "$organizerId": {
        ".read": true,
        ".write": false
      }
    },
    "reviews": {
      ".read": true,
      ".write": false,
      "$reviewId": {
        ".read": true,
        ".write": false
      }
    },
    "favorites": {
      ".read": "auth != null",
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "staff_uploads": {
      ".write": false,
      ".read": "auth != null"
    }
  }
}
