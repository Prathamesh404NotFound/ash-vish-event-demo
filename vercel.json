{
  "framework": null,
  "functions": {
    "api/[[...route]].ts": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[[...route]]"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/((?!api/|sitemap\\.xml|robots\\.txt|favicon.*|manifest\\.json|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
